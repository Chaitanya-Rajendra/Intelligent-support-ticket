{
  "name": "Intelligent Support Ticket Triage",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "New Ticket Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/tickets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"source\": $json.source, \"raw_text\": $json.text, \"customer_id\": $json.customer_id } }}",
        "options": {}
      },
      "id": "classify-ticket",
      "name": "Classify Ticket (FastAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "auto_resolved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-auto-resolved",
      "name": "Auto-Resolved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "fromEmail": "support@yourcompany.com",
        "toEmail": "={{ $('New Ticket Webhook').item.json.customer_email }}",
        "subject": "Re: Your support request",
        "text": "={{ $json.auto_response }}",
        "options": {}
      },
      "id": "send-auto-response",
      "name": "Send Auto Response",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [920, 200]
    },
    {
      "parameters": {
        "channel": "#support-queue",
        "text": "=New ticket routed: [{{ $json.priority }}] {{ $json.intent }} → {{ $json.suggested_department }} (confidence: {{ $json.confidence }})"
      },
      "id": "notify-team",
      "name": "Notify Support Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [920, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1140, 300]
    }
  ],
  "connections": {
    "New Ticket Webhook": {
      "main": [[{ "node": "Classify Ticket (FastAPI)", "type": "main", "index": 0 }]]
    },
    "Classify Ticket (FastAPI)": {
      "main": [[{ "node": "Auto-Resolved?", "type": "main", "index": 0 }]]
    },
    "Auto-Resolved?": {
      "main": [
        [{ "node": "Send Auto Response", "type": "main", "index": 0 }],
        [{ "node": "Notify Support Channel", "type": "main", "index": 0 }]
      ]
    },
    "Send Auto Response": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Notify Support Channel": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  }
}
